{#-
  glossary：稳定币合规词典。内容在 src/_data/glossary.yml，按页面语言（lang）渲染。
  每条术语的 id 是锚点：/glossary/#kyt 直接跳到 KYT。
  link 写英文路径；英文页没有对应页面（例如文档只有中文版）时，自动改指中文页并注明。
  同时输出 schema.org DefinedTermSet 结构化数据。
  字段：s.id（可选，整个版块的锚点）
-#}
{%- set Ls = {
  en: { index: "Groups", filter: "Filter terms", placeholder: "Filter, e.g. KYT or Travel Rule", learn: "Learn more", learnZh: "Learn more (in Chinese)", empty: "No matching terms.", count: "terms", setName: "Stablecoin compliance glossary", setDesc: "Definitions of AML, regulatory, onchain, risk and DART terms for stablecoin compliance." },
  zh: { index: "分组", filter: "筛选术语", placeholder: "输入关键词，例如 KYT、旅行规则", learn: "了解更多", learnZh: "了解更多", empty: "没有匹配的术语。", count: "条", setName: "稳定币合规词典", setDesc: "稳定币合规常用术语：反洗钱基础概念、各地监管、链上机制、风险类型和 DART 概念。" }
} -%}
{%- set L = Ls[lang] or Ls.en -%}
{%- set other = "en" if lang == "zh" else "zh" -%}
{%- set pageAbs = page.url | absolute(site.url) -%}
{%- set byGroup = glossary.terms | groupby("group") -%}
<section class="section glossary"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    <div class="glossary-tools">
      <nav class="glossary-index" aria-label="{{ L.index }}">
        {%- for g in glossary.groups %}
        <a class="glossary-chip" href="#{{ g.id }}">{{ g[lang].name }}<span>{{ (byGroup[g.id] or []) | length }}</span></a>
        {%- endfor %}
      </nav>
      <label class="glossary-filter" hidden>
        <span class="visually-hidden">{{ L.filter }}</span>
        <input type="search" placeholder="{{ L.placeholder }}" autocomplete="off" spellcheck="false">
      </label>
    </div>
    <p class="glossary-empty" hidden>{{ L.empty }}</p>

    {%- for g in glossary.groups %}
    <div class="glossary-group" id="{{ g.id }}">
      <div class="glossary-group-head">
        <h2>{{ g[lang].name }}</h2>
        {%- if g[lang].lead %}<p>{{ g[lang].lead }}</p>{% endif %}
      </div>
      <dl class="glossary-list">
        {%- for t in (byGroup[g.id] or []) %}
        {%- set tx = t[lang] %}
        {%- set alt = t[other].term %}
        {#- 链接：先找本语言页面，英文页找不到再退到中文页 -#}
        {%- set href = "" %}{% set hrefZh = false %}
        {%- if t.link %}
          {%- set cand = t.link | locale(lang) %}
          {%- if collections.all | findBy("url", cand) %}{% set href = cand %}
          {%- elif lang != "zh" and (collections.all | findBy("url", t.link | locale("zh"))) %}{% set href = t.link | locale("zh") %}{% set hrefZh = true %}
          {%- endif %}
        {%- endif %}
        <div class="glossary-term" id="{{ t.id }}">
          <dt>
            <a class="glossary-name" href="#{{ t.id }}">{{ tx.term }}</a>
            {%- if t.aka and t.aka != tx.term %} <span class="chip">{{ t.aka }}</span>{% endif %}
            {%- if alt and alt != tx.term and alt != t.aka %}<span class="glossary-alt" lang="{{ i18n[other].htmlLang }}">{{ alt }}</span>{% endif %}
          </dt>
          <dd>
            <p>{{ tx.def | mdi | safe }}</p>
            {%- if href %}<a class="link-arrow" href="{{ href }}"{% if hrefZh %} hreflang="zh-CN"{% endif %}>{{ L.learnZh if hrefZh else L.learn }}</a>{% endif %}
          </dd>
        </div>
        {%- endfor %}
      </dl>
    </div>
    {%- endfor %}
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "DefinedTermSet",
  "@id": "{{ pageAbs }}#glossary",
  "name": {{ L.setName | dump | safe }},
  "description": {{ L.setDesc | dump | safe }},
  "inLanguage": "{{ i18n[lang].htmlLang }}",
  "url": "{{ pageAbs }}",
  "publisher": { "@id": "{{ site.url }}/#org" },
  "hasDefinedTerm": [
    {%- for t in glossary.terms %}
    {
      "@type": "DefinedTerm",
      "@id": "{{ pageAbs }}#{{ t.id }}",
      "name": {{ t[lang].term | dump | safe }},
      {%- if t.aka %}
      "alternateName": {{ t.aka | dump | safe }},
      {%- endif %}
      "description": {{ t[lang].def | mdi | striptags | dump | safe }},
      "url": "{{ pageAbs }}#{{ t.id }}",
      "inDefinedTermSet": "{{ pageAbs }}#glossary"
    }{% if not loop.last %},{% endif %}
    {%- endfor %}
  ]
}
</script>

<style>
.glossary .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.glossary-tools { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; padding-bottom: 28px; margin-bottom: clamp(32px, 5vw, 56px); border-bottom: 1px solid var(--line); }
.glossary-index { display: flex; flex-wrap: wrap; gap: 8px; min-width: 0; }
.glossary-chip { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; font-size: 14px; font-weight: 600; color: var(--accent); background: #e6eefd; transition: background .2s, color .2s; }
.glossary-chip span { font-size: 12px; font-weight: 500; color: var(--text-3); }
.glossary-chip:hover { background: var(--accent); color: var(--accent-ink); }
.glossary-chip:hover span { color: inherit; opacity: .8; }
.glossary-filter { flex: 0 1 320px; min-width: 0; }
.glossary-filter input { width: 100%; height: 44px; padding: 0 14px; font: inherit; font-size: 15px; color: var(--text); background: var(--surface-2); border: 1px solid var(--line); border-radius: 0; -webkit-appearance: none; appearance: none; }
.glossary-filter input:focus { outline: none; border-color: var(--accent); background: var(--surface); box-shadow: 0 0 0 3px rgba(13, 79, 211, .12); }
.glossary-empty { color: var(--text-2); }

.glossary-group { display: grid; grid-template-columns: minmax(0, 280px) minmax(0, 1fr); gap: 24px 64px; padding: clamp(32px, 4vw, 48px) 0; border-bottom: 1px solid var(--line); }
.glossary-empty + .glossary-group { padding-top: 0; }
.glossary-group:last-child { border-bottom: 0; padding-bottom: 0; }
.glossary-group-head { align-self: start; position: sticky; top: calc(var(--header-h) + 24px); }
.glossary-group-head h2 { font-size: clamp(24px, 2.6vw, 32px); margin: 0 0 10px; }
.glossary-group-head p { margin: 0; color: var(--text-2); font-size: 15px; }

.glossary-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin: 0; }
.glossary-term { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 24px; background: var(--surface); border: 1px solid var(--line); scroll-margin-top: calc(var(--header-h) + 16px); transition: border-color .2s, box-shadow .2s; }
.glossary-term:target { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(13, 79, 211, .12); }
.glossary-term dt { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 0; }
.glossary-name { font-size: 18px; font-weight: 700; line-height: 1.3; color: var(--text); overflow-wrap: anywhere; }
.glossary-name:hover { color: var(--accent); }
.glossary-term .chip { white-space: normal; overflow-wrap: anywhere; }
.glossary-alt { flex-basis: 100%; font-size: 13.5px; color: var(--text-3); }
.glossary-term dd { display: flex; flex-direction: column; gap: 10px; flex: 1; margin: 0; }
.glossary-term dd p { margin: 0; color: var(--text-2); font-size: 15.5px; overflow-wrap: break-word; }
.glossary-term dd b, .glossary-term dd strong { color: var(--text); }
.glossary-term .link-arrow { margin-top: auto; padding-top: 4px; }
.glossary-term[hidden], .glossary-group[hidden] { display: none; }

@media (max-width: 1100px) {
  .glossary-list { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 860px) {
  .glossary-group { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  .glossary-group-head { position: static; }
}
@media (max-width: 640px) {
  .glossary-filter { flex-basis: 100%; }
  .glossary-term { padding: 20px; }
  .glossary-chip { padding: 7px 12px; font-size: 13.5px; }
}
</style>

<script>
(function () {
  var root = document.currentScript && document.currentScript.previousElementSibling;
  while (root && !(root.classList && root.classList.contains("glossary"))) root = root.previousElementSibling;
  if (!root) return;
  var box = root.querySelector(".glossary-filter"), input = box && box.querySelector("input");
  var empty = root.querySelector(".glossary-empty");
  if (!input) return;
  box.hidden = false;
  var groups = [].slice.call(root.querySelectorAll(".glossary-group"));
  input.addEventListener("input", function () {
    var q = input.value.trim().toLowerCase(), any = false;
    groups.forEach(function (g) {
      var shown = 0;
      [].forEach.call(g.querySelectorAll(".glossary-term"), function (t) {
        var hit = !q || t.textContent.toLowerCase().indexOf(q) > -1;
        t.hidden = !hit; if (hit) shown++;
      });
      g.hidden = shown === 0; if (shown) any = true;
    });
    empty.hidden = any;
  });
})();
</script>
