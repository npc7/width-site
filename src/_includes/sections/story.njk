{#- story：品类故事「有关联，不等于收了问题资金」，左右对照「只看关联」vs「DART 看钱真的怎么流」。
    title, lead, old{label, q, points[], result}, new{label, q, points[], result}, marks[[左, 右]]
    左右各带一张小示意图：同样三个地址，左边判「有关联 → 高风险」，右边按时间核对后排除。
    marks 是底部一排「A ≠ B」：DART 的三个不等于（准 / 不漏 / 说得清），写法见 MESSAGING.md 第 6 节。 -#}
{%- set zh = (lang == 'zh') -%}
<section class="section story {{ s.tone }}"{% if s.id %} id="{{ s.id }}"{% endif %}>
  <div class="container">
    {% include "partials/section-head.njk" %}
    <div class="story-grid">
      {%- for side in ['old', 'new'] %}
      {%- set c = s[side] %}
      <div class="story-col story-{{ side }}">
        <span class="story-label">{{ c.label }}</span>
        <h3>{{ c.q }}</h3>
        <svg class="story-viz" viewBox="0 0 420 118" role="img" aria-label="{{ c.result }}">
          {%- if side == 'old' %}
          <line x1="70" y1="44" x2="190" y2="44" class="sv-edge risk e1"/>
          <line x1="230" y1="44" x2="350" y2="44" class="sv-edge risk e2"/>
          {%- else %}
          <line x1="70" y1="44" x2="190" y2="44" class="sv-edge risk"/>
          <line x1="230" y1="44" x2="350" y2="44" class="sv-ghost"/>
          <line x1="230" y1="44" x2="350" y2="44" class="sv-edge cut"/>
          <text x="130" y="30" class="sv-time">{{ '10:05 到账' if zh else 'in 10:05' }}</text>
          <text x="290" y="30" class="sv-time cut">{{ '10:02 已转出' if zh else 'out 10:02' }}</text>
          <g transform="translate(290 44)"><g class="sv-x"><line x1="-7" y1="-7" x2="7" y2="7"/><line x1="7" y1="-7" x2="-7" y2="7"/></g></g>
          {%- endif %}
          <circle cx="50" cy="44" r="20" class="sv-node risk"/>
          <circle cx="210" cy="44" r="20" class="sv-node mid"/>
          <circle cx="370" cy="44" r="20" class="sv-node you"/>
          {%- if side == 'old' %}
          <circle cx="50" cy="44" r="7" class="sv-coin red"/>
          {%- else %}
          <circle cx="210" cy="44" r="7" class="sv-coin gray"/>
          <circle cx="50" cy="44" r="7" class="sv-coin red"/>
          {%- endif %}
          <text x="50" y="86" class="sv-cap">{{ '风险地址' if zh else 'Risky address' }}</text>
          <text x="210" y="86" class="sv-cap">{{ '中间地址' if zh else 'Intermediary' }}</text>
          <text x="370" y="86" class="sv-cap">{{ '你的用户' if zh else 'Your user' }}</text>
          {%- if side == 'old' %}
          <text x="210" y="112" class="sv-verdict bad">{{ '有关联 → 高风险' if zh else 'Connected → high risk' }}</text>
          {%- else %}
          <text x="210" y="112" class="sv-verdict good">{{ '钱没流过来 → 不计入' if zh else 'Money never reached you → excluded' }}</text>
          {%- endif %}
        </svg>
        <ul class="story-points">
          {%- for p in c.points %}<li>{{ p | mdi | safe }}</li>{% endfor %}
        </ul>
        <p class="story-result">{{ c.result | mdi | safe }}</p>
      </div>
      {%- endfor %}
    </div>
    {%- if s.marks %}
    <ul class="story-marks" aria-label="{{ 'DART 的三个不等于' if zh else 'Three things DART keeps apart' }}">
      {%- for m in s.marks %}
      <li><span>{{ m[0] }}</span><b aria-label="{{ '不等于' if zh else 'does not mean' }}">≠</b><span>{{ m[1] }}</span></li>
      {%- endfor %}
    </ul>
    {%- endif %}
    {%- if s.tagline %}<p class="story-tagline">{{ s.tagline | safe }}</p>{% endif %}
  </div>
</section>
