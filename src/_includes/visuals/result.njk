{#- 筛查结果示意卡：分数、处置、命中明细、快照。地址为示意。
    data-at（第几步出现）/ data-d（这一步里再晚几秒）/ data-hit（属于第几条命中）只给首页 console 的演示用（assets/js/console.js），别处不起作用。 -#}
{%- set zh = (lang == 'zh') -%}
<figure class="viz viz-result-card{% if consoleDemo %} viz-demo{% endif %}">
  <header>
    <div>
      <p class="mini-label">KYA · Tron · USDT</p>
      <p class="mono" data-at="0" data-d="1.3">TZCL2K…3ULr</p>
    </div>
    <span class="chip chip-review" data-at="6" data-d=".3">{{ '复核' if zh else 'Review' }}</span>
  </header>
  <div class="result-score">
    <div class="score-dial"><span class="dial-n">{% if consoleDemo %}36{% endif %}</span><small>/100</small></div>
    <ol class="bands" aria-label="{{ '处置档位' if zh else 'Disposition bands' }}">
      <li class="pass">0–19</li><li class="review is-on" data-at="6">20–49</li><li class="edd">50–79</li><li class="block">80–100</li>
    </ol>
  </div>
  <table class="hits">
    <thead><tr><th>{{ '命中' if zh else 'Hit' }}</th><th>{{ '跳数' if zh else 'Hop' }}</th><th>{{ '占比' if zh else 'Share' }}</th><th>{{ '加分' if zh else 'Points' }}</th></tr></thead>
    <tbody>
      <tr data-at="2" data-d=".3" data-hit="1"><td><span class="dot risk"></span>{{ '制裁实体 · 流入' if zh else 'Sanctions · inbound' }}</td><td>2</td><td>18%</td><td>+30</td></tr>
      <tr data-at="3" data-d=".2" data-hit="2"><td><span class="dot edd"></span>{{ '混币器 · 流入' if zh else 'Mixer · inbound' }}</td><td>1</td><td>6%</td><td>+6</td></tr>
      <tr class="excluded" data-at="4" data-d=".3" data-hit="3"><td><span class="dot mute"></span>{{ '黑客 · 时间倒流' if zh else 'Hacker · backwards in time' }}</td><td>2</td><td>—</td><td>{{ '排除' if zh else 'excluded' }}</td></tr>
      <tr class="excluded exempt" data-at="5" data-d=".3" data-hit="4"><td><span class="dot ex"></span>{{ '交易所对手方' if zh else 'Exchange counterparty' }}</td><td>1</td><td>—</td><td>{{ '豁免' if zh else 'exempt' }}</td></tr>
    </tbody>
  </table>
  <footer class="mono" data-at="6" data-d=".6">{{ '快照已保存 · 不可篡改' if zh else 'Snapshot saved · immutable' }}</footer>
</figure>
