{%- set t = i18n[lang] -%}
<footer class="site-footer">
  <div class="disposition-bar" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="{{ '/' | locale(lang) }}"><img src="/assets/img/width-logo.svg" alt="WIDTH" width="96" height="20"><span class="brand-product">DART</span></a>
      <p>{{ t.footerTagline }}</p>
      <p class="footer-free">{{ t.footerFree }}</p>
      <div class="footer-contact">
        <p class="eyebrow">{{ t.contactTitle }}</p>
        <a href="mailto:{{ site.contact.sales }}">{{ site.contact.sales }}</a>
        <a href="tel:{{ site.contact.phone | replace(' ', '') }}">{{ site.contact.phone }}</a>
        <span>{{ site.contact.offices | tr(lang) }}</span>
      </div>
    </div>
    {%- for col in nav.footer %}
    <div class="footer-col">
      <p class="eyebrow">{{ col.title | tr(lang) }}</p>
      <ul>
        {%- for l in col.items %}
        <li><a href="{{ l.href | locale(lang) }}">{{ l.label | tr(lang) }}</a></li>
        {%- endfor %}
      </ul>
    </div>
    {%- endfor %}
  </div>
  <div class="container footer-bottom">
    <span>© 2014–2026 {{ t.rights }}</span>
    <span class="footer-links">
      <a href="{{ site.links.privacy }}">{{ t.privacy }}</a>
      <a href="{{ site.links.security }}">{{ t.security }}</a>
      <a href="{{ site.social.x }}" aria-label="X">X</a>
      <a href="{{ site.social.linkedin }}">LinkedIn</a>
      <a href="{{ site.social.youtube }}">YouTube</a>
    </span>
  </div>
</footer>
